# Placeholders only. Never commit real credentials. Copy to .env for local development.

# Node runtime mode: development | test | production
NODE_ENV=development
# Deployment environment label: local | development | test | staging | production
APP_ENV=local
# Only "sandbox" is supported until an approved provider integration exists.
PAYMENT_PROVIDER_MODE=sandbox

PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins. "*" is rejected when APP_ENV is staging or production.
CORS_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops (0 when running without a proxy).
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT=100kb

# The replica set is required for multi-document transactions used by the ledger.
MONGODB_URI=mongodb://localhost:27017/mini_payment?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
