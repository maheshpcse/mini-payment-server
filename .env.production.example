# Reference for Railway service variables. Set real values in Railway > Variables; never commit them.
# Validate with: npm run build && npm run deploy:check (reads the current environment, prints no values).

NODE_ENV=production
APP_ENV=production
PAYMENT_PROVIDER_MODE=sandbox
LOG_LEVEL=info
# Railway injects PORT; leave it unset there.

# Exact frontend origin(s): scheme + host only, no repository path, no trailing slash. Comma-separated.
CORS_ORIGINS=https://maheshpcse.github.io
# Railway terminates TLS in one proxy hop.
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=100kb

# Must be a replica set (transactions). MongoDB Atlas (mongodb+srv://) or a Railway replica-set template.
MONGODB_URI=mongodb+srv://SET-IN-RAILWAY/mini_payment?retryWrites=true&w=majority
# Reference the Railway Redis service, e.g. ${{Redis.REDIS_URL}}
REDIS_URL=redis://SET-IN-RAILWAY:6379

# Signs access tokens. Generate once with `openssl rand -base64 48`; rotating it signs everyone out.
JWT_SECRET=SET-IN-RAILWAY
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# github.io and railway.app are different sites, so the refresh cookie must be SameSite=None; Secure; Partitioned.
REFRESH_COOKIE_SAMESITE=none
